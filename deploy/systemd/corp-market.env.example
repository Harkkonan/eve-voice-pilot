# Copy to /etc/eve-voice-pilot/corp-market.env on the VM.
# Fill real values only on the VM or in your secret manager.
# Any string variable can also be provided as NAME_FILE=/path/to/secret.
# Do not set a non-empty NAME and NAME_FILE at the same time.

CORP_MARKET_HOST=127.0.0.1
CORP_MARKET_PORT=8770
CORP_MARKET_PUBLIC_HOSTING_MODE=1
CORP_MARKET_PUBLIC_BASE_URL=https://market.example.com
CORP_MARKET_SSO_CALLBACK_URL=https://market.example.com/flight/callback

CORP_MARKET_SSO_CLIENT_ID=
CORP_MARKET_SSO_CLIENT_SECRET=
CORP_MARKET_ALLOWED_CHARACTER_IDS=
CORP_MARKET_ALLOWED_CORPORATION_IDS=
CORP_MARKET_ALLOWED_ALLIANCE_IDS=
CORP_MARKET_ALLOW_ANY_AUTHENTICATED=0

CORP_MARKET_ADMIN_TOKEN=
CORP_MARKET_TRUSTED_MEMBERS_CAN_WRITE_MARKET=0
CORP_MARKET_GOOGLE_SITE_VERIFICATION=
CORP_MARKET_GOOGLE_SITE_VERIFICATION_FILE=

CORP_MARKET_MARKET_DB_PATH=/var/lib/eve-voice-pilot/profiles/corp_market.sqlite3
CORP_MARKET_DISCORD_ALERT_SETTINGS_PATH=/var/lib/eve-voice-pilot/profiles/corp_discord_alert_settings.json
CORP_MARKET_DISCORD_POST_SETTINGS_PATH=/var/lib/eve-voice-pilot/profiles/corp_discord_post_settings.json
CORP_MARKET_DISCORD_FITTING_POST_SETTINGS_PATH=/var/lib/eve-voice-pilot/profiles/corp_fitting_discord_post_settings.json

# Optional server-default webhook. Prefer saved local settings for specific destinations.
CORP_MARKET_DISCORD_WEBHOOK_URL=
CORP_MARKET_DISCORD_FORUM_TAG_IDS=
CORP_MARKET_DISCORD_FORUM_TAG_MAP=
