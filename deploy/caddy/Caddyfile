# Replace CORP_MARKET_PUBLIC_HOST with the real public host.
# Keep the Python app bound to 127.0.0.1 on a VM; Docker uses the internal service upstream.

{$CORP_MARKET_PUBLIC_HOST:market.example.com} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-X-Powered-By
		-Server
	}

	reverse_proxy {$CORP_MARKET_UPSTREAM:127.0.0.1:8770}
}
